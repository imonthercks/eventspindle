{
  "name": "eventspindle-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware packages apps infra scripts",
    "format": "oxfmt packages apps infra scripts package.json nx.json tsconfig.base.json pnpm-workspace.yaml cdk.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check packages apps infra scripts package.json nx.json tsconfig.base.json pnpm-workspace.yaml cdk.json .oxlintrc.json .oxfmtrc.json",
    "typecheck": "nx run-many -t typecheck",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "model:validate": "node scripts/validate-model.mjs",
    "model:generate": "node scripts/not-implemented.mjs model:generate",
    "dev:local": "node scripts/not-implemented.mjs dev:local",
    "smoke:local": "node scripts/not-implemented.mjs smoke:local",
    "smoke:aws": "node scripts/not-implemented.mjs smoke:aws",
    "infra:synth": "cdk synth --app 'pnpm exec tsx infra/bin/eventspindle.ts'",
    "infra:deploy:dev": "node scripts/not-implemented.mjs infra:deploy:dev",
    "infra:destroy:dev": "node scripts/not-implemented.mjs infra:destroy:dev",
    "db:migrate:dev": "node scripts/not-implemented.mjs db:migrate:dev",
    "slice:release": "node scripts/not-implemented.mjs slice:release"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "aws-cdk": "2.1146.1",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "nx": "24.0.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "pnpm": ">=10.32.0 <11"
  },
  "packageManager": "pnpm@10.32.0",
  "nx": {
    "includedScripts": [],
    "targets": {
      "format:check": {
        "command": "pnpm exec oxfmt --check packages apps infra scripts package.json nx.json tsconfig.base.json pnpm-workspace.yaml cdk.json .oxlintrc.json .oxfmtrc.json",
        "cache": true,
        "inputs": [
          "{workspaceRoot}/packages/**/*",
          "{workspaceRoot}/apps/**/*",
          "{workspaceRoot}/infra/**/*",
          "{workspaceRoot}/scripts/**/*",
          "{workspaceRoot}/pnpm-lock.yaml",
          "{workspaceRoot}/package.json",
          "{workspaceRoot}/nx.json",
          "{workspaceRoot}/tsconfig.base.json",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/cdk.json",
          "{workspaceRoot}/.oxlintrc.json",
          "{workspaceRoot}/.oxfmtrc.json"
        ]
      }
    }
  }
}
